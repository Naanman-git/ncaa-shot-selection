  "hypothesis_results": [
    {
      "id": "H1",
      "hypothesis": "Predicted make probability decreases as distance increases.",
      "method": "Spearman association across prespecified held-out distance bands.",
      "result": "Spearman rho = -0.950 across 9 bands.",
      "status": "supported"
    },
    {
      "id": "H2",
      "hypothesis": "A lower-probability three-point zone can have higher expected value than a two-point zone.",
      "method": "Compare held-out corner-three and paint averages from the frozen model.",
      "result": "Corner three: 36.0% predicted FG and 1.079 EP; paint: 41.9% predicted FG and 0.838 EP.",
      "status": "supported"
    },
    {
      "id": "H3",
      "hypothesis": "Raw zone rates move toward pooled estimates after shrinkage.",
      "method": "Compare raw and 30-attempt-prior rates in the prespecified case study.",
      "result": "Largest change: mid, 41.3% raw to 40.2% shrunk.",
      "status": "supported"
    },
    {
      "id": "H4",
      "hypothesis": "Spatial and prior player history improve held-out probability prediction over a zone baseline.",
      "method": "Compare final-test Brier score and log loss after model selection was frozen.",
      "result": "Selected model improved Brier by 0.0019 and log loss by 0.0039.",
      "status": "supported"
    }
  ],
